{
  "name": "iina-scrobbler",
  "version": "0.2.0",
  "private": true,
  "description": "IINA plugin that scrobbles what you play to Last.fm",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=23.6",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:nosecrets": "node build.mjs --allow-missing-secrets",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest",
    "check": "biome check --write .",
    "prepare": "mise exec -- prek install",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.0",
    "iina-plugin-definition": "^0.99.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
